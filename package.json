{
  "name": "recomp-10m",
  "version": "1.0.0",
  "private": true,
  "description": "Recomp 10M - entrenamiento, nutrición y progreso",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "ios:prepare": "npm run build:mobile && npx cap sync ios",
    "ios:add": "npm run build:mobile && npx cap add ios",
    "ios:open": "npm run ios:prepare && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
